{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard board.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "story", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "jiraUrl": { "type": ["string", "null"] },
        "status": { "enum": ["in_progress", "in_review", "done"] }
      }
    },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "taskId": { "type": "string", "pattern": "^T[0-9]+$" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "status", "dependsOn", "file", "repos", "prs"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["pr", "spike", "decision"] },
        "status": { "enum": ["todo", "planning", "planned", "implementing", "done", "dropped"] },
        "blocked": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1 } }
        },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "file": { "type": "string", "minLength": 1 },
        "repos": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prs": { "type": "array", "items": { "$ref": "#/$defs/pr" } },
        "jiraSubtask": { "type": ["string", "null"] },
        "agent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["pane", "skill", "startedAt"],
          "properties": {
            "pane": { "type": "string", "minLength": 1 },
            "skill": { "type": "string", "minLength": 1 },
            "startedAt": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "url", "state"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "state": { "enum": ["draft", "ready", "merged", "closed"] }
      }
    }
  }
}
