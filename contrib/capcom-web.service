# Keeps `capcom web` running from login on. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/capcom-web.service ~/.config/systemd/user/
#   (edit CAPCOM_ROOT below, and ExecStart if capcom is not in ~/.local/bin)
#   systemctl --user daemon-reload && systemctl --user enable --now capcom-web
# Logs: journalctl --user -u capcom-web
[Unit]
Description=capcom web: story boards and open PRs on 127.0.0.1:7878
After=network-online.target

[Service]
ExecStart=%h/.local/bin/capcom web --port 7878
Environment=CAPCOM_ROOT=%h/stories
# the folder new Claude Code sessions started from the page begin in
Environment=CAPCOM_WORKDIR=%h/code
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
# what the page changes: its cache, the settings it shares with capcom-tui and the stories folder
ReadWritePaths=%h/.cache/capcom %h/.config/capcom %h/stories
Nice=10

[Install]
WantedBy=default.target
